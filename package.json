{
  "name": "vue-mastery",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://sh3yee.github.io/vue-mastery/",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun run type-check && bun run build-only",
    "preview": "bun --bun vite preview",
    "build-only": "bun --bun vite build",
    "type-check": "bun scripts/vue-tsc.ts --build"
  },
  "dependencies": {
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
