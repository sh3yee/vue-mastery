{
  "include": [
    "vite.config.*",
    "tooling/**/*.ts",
    "scripts/**/*.ts",
    "contracts/**/*.ts",
    "content/**/*.ts",
    "tests/**/*.ts"
  ],
  "compilerOptions": {
    "lib": [
      "ESNext"
    ],
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "types": [
      "bun"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.bun.tsbuildinfo"
  }
}
